"${RESET}"

#: install.sh:101
#, sh-format
msgid "Installation of ${file_description}: \"${dest_path}\"... "
msgstr "Installation de ${file_description}: \"${dest_path}\"... "

#: install.sh:103
#, sh-format
msgid "${ERR}ERROR: failed to install the file.${RESET}"
msgstr "${ERR}ERREUR: échec de l'installation du fichier.${RESET}"

#: install.sh:109
#, sh-format
msgid "${ERR}ERROR: failed to set access rights to the file.${RESET}"
msgstr ""
"${ERR}ERREUR: échec de la modification des droits d'accès du fichier.${RESET}"

#: install.sh:113 install.sh:131
msgid "ok."
msgstr "ok."

#: install.sh:126
#, sh-format
msgid "Creation of the directory tree \"${directory_tree}\"... "
msgstr "Creation de l'arborescence \"${directory_tree}\"... "

#: install.sh:128
#, sh-format
msgid "${ERR}ERROR: failed to create the directory tree.${RESET}"
msgstr "${ERR}ERREUR: échec de la création de l'arborescence.${RESET}"

#: install.sh:143
msgid "Shrink PDF"
msgstr "Réduire PDF"

#: install.sh:148
#, sh-format
msgid ""
"${ERR}ERROR: The \"gs\" command is required but not installed. "
"(Ghostscript)${RESET}"
msgstr ""
"${ERR}ERREUR: La commande \"gs\" est requise mais n'est pas installée. "
"(Ghostscript)${RESET}"

#: install.sh:154
#, sh-format
msgid ""
"${ERR}ERROR: The \"bc\" command is required but not installed. (Basic "
"Calulator)${RESET}"
msgstr ""
"${ERR}ERREUR: La commande \"bc\" est requise mais n'est pas installée. "
"(Basic Calulator)${RESET}"

#: install.sh:167
#, sh-format
msgid "This will install the shell command \"${SCRIPT_FILENAME}\"."
msgstr "Cela va installer la commande shell \"${SCRIPT_FILENAME}\"."

#: install.sh:169
#, sh-format
msgid ""
"This will also install a new \"${NEMO_ACTION_MENU}\" context menu entry "
"(\"right-click\") in Nemo, the file manager, for PDF files."
msgstr ""
"Cela va installer un nouveau choix \"${NEMO_ACTION_MENU}\" dans le menu "
"contextuel (\"clic-droit\") de Nemo le gestionnaire de fichiers, pour les "
"fichiers PDF."

#: install.sh:171
#, sh-format
msgid ""
"The file manager Nemo has NOT been detected. If you install it later, you "
"will see a \"${NEMO_ACTION_MENU}\" context menu entry (\"right-click\") of "
"PDF files."
msgstr ""
"Le gestionnaire de fichiers Nemo n'a pas été détecté. Si vous l'installez "
"plus tard, vous verrez un choix \"${NEMO_ACTION_MENU}\" dans le menu "
"contextuel (\"clic-droit\") de Nemo, pour les fichiers PDF."

#: install.sh:173
msgid "Continue?"
msgstr "Continuer ?"

#: install.sh:174
msgid "Canceled, ok."
msgstr "Annulé, ok.'"

#
#: install.sh:181
msgid "You need elevated privileges to install: "
msgstr "Vous avez besoins de privilèges élevés pour installer : "

#: install.sh:184
#, sh-format
msgid ""
"${ERR}ERROR: Installation canceled: Failed to get elevated privileges (sudo)."
"${RESET}"
msgstr ""
"${ERR}ERROR: Installation annulée : échec pour l'obtention des privilèges "
"élevés (sudo).${RESET}"

#: install.sh:187
msgid "ok for elevated privileges (sudo)."
msgstr "ok pour les privilèges élevés (sudo)."

#: install.sh:192
msgid "the main command"
msgstr "la commande principale"

#: install.sh:202
msgid "the French translation"
msgstr "la traduction Française"

#: install.sh:210
#, sh-format
msgid "the Nemo action \"${NEMO_ACTION_MENU}\""
msgstr "l'action Nemo"

#: install.sh:218
msgid "the English man page"
msgstr "la page man Anglaise"

#: install.sh:226
msgid "the French man page"
msgstr "la page man Française"

#: install.sh:235
msgid "The installation succeeded."
msgstr "L'installation a réussi."

#: install.sh:237
#, sh-format
msgid ""
"You may have to close and relaunch the file manager Nemo to use the new "
"\"${NEMO_ACTION_MENU}\" context menu entry for PDF files."
msgstr ""
"Vous aurez peut-être à fermer et relancer le gestionnaire de fichiers Nemo "
"pour utiliser le nouveau choix \"${NEMO_ACTION_MENU}\" du menu contextuel "
"des fichiers PDF."
