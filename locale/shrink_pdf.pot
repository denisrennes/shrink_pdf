#: shrink_pdf:44
#, sh-format
msgid "${HIGHLIGHT}Press any key...${RESET}"
msgstr ""

#: shrink_pdf:57
#, sh-format
msgid "${HIGHLIGHT}Press any key to finish...${RESET}"
msgstr ""

#: shrink_pdf:64 shrink_pdf:240 shrink_pdf:254
#, sh-format
msgid ""
"${ERR}ERROR: ${function_name} function called with incorrect number of "
"parameter.${RESET}"
msgstr ""

#: shrink_pdf:77
#, sh-format
msgid "${this_script_name} tries to shrink the size of PDF files."
msgstr ""

#: shrink_pdf:79
#, sh-format
msgid ""
"It works particularly well with PDF files containing unoptimized images, "
"such as documents scanned with xsane."
msgstr ""

#: shrink_pdf:81
#, sh-format
msgid ""
"If successful, i.e., if the file has been reduced by at least 10%, the "
"original file is renamed \"<name>.ORIGINAL[.ext]\" and the reduced file "
"takes its name."
msgstr ""

#: shrink_pdf:82
#, sh-format
msgid ""
"When the reduction is less than 10%, ${this_script_name} reports this and "
"leaves the document unchanged."
msgstr ""

#: shrink_pdf:84
#, sh-format
msgid "Usage:    ${this_script_name} [OPTION]... PDF_FILE..."
msgstr ""

#: shrink_pdf:86
#, sh-format
msgid "OPTION:"
msgstr ""

#: shrink_pdf:87
#, sh-format
msgid "  -k  --press_any_key   Wait for any key to be pressed at the end."
msgstr ""

#: shrink_pdf:88
#, sh-format
msgid ""
"  -x  --extreme_shrink  Try to shrink even more, at the expense of quality."
msgstr ""

#: shrink_pdf:90
#, sh-format
msgid "      --version         Output version information and exit."
msgstr ""

#: shrink_pdf:91
#, sh-format
msgid "      --help            Display this help and exit."
msgstr ""

#: shrink_pdf:93
#, sh-format
msgid "PDF_FILE:"
msgstr ""

#: shrink_pdf:94
#, sh-format
msgid "    One or more PDF files to shrink."
msgstr ""

#: shrink_pdf:96
#, sh-format
msgid "Exit status:"
msgstr ""

#: shrink_pdf:97
#, sh-format
msgid "    0  Ok. (Some files may not be shrinked because already optimized.)"
msgstr ""

#: shrink_pdf:98
#, sh-format
msgid "    1  Some files with errors trying to shrink or rename them."
msgstr ""

#: shrink_pdf:99
#, sh-format
msgid "  253  Error: missing prerequisite."
msgstr ""

#: shrink_pdf:100
#, sh-format
msgid "  254  Error in the arguments of the calling command line."
msgstr ""

#: shrink_pdf:101
#, sh-format
msgid ""
"  255  Program error (bug): wrong number of arguments for a function call, "
"etc."
msgstr ""

#: shrink_pdf:103
#, sh-format
msgid "Examples:"
msgstr ""

#: shrink_pdf:105
#, sh-format
msgid "${this_script_name} ./big_doc.pdf ./another_doc.pdf"
msgstr ""

#: shrink_pdf:106
#, sh-format
msgid "  This will try to shrink the two pdf files."
msgstr ""

#: shrink_pdf:108
#, sh-format
msgid "${this_script_name} -x ./big_doc.pdf"
msgstr ""

#: shrink_pdf:109
#, sh-format
msgid ""
"  With the -x option (or --extreme_shrink) this will try to shrink even more."
msgstr ""

#: shrink_pdf:166
#, sh-format
msgid "${ERR}ERROR: unknown option argument \"${arg}\".${RESET}"
msgstr ""

#: shrink_pdf:175
#, sh-format
msgid "${ERR}ERROR: cannot access \"${arg}\". No such file.${RESET}"
msgstr ""

#: shrink_pdf:182
#, sh-format
msgid "${ERR}ERROR: at least one FILE argument is required.${RESET}"
msgstr ""

#: shrink_pdf:267
#, sh-format
msgid ""
"${ERR}ERROR: The \"gs\" command is required but not installed. "
"(Ghostscript)${RESET}"
msgstr ""

#: shrink_pdf:273
#, sh-format
msgid ""
"${ERR}ERROR: The \"bc\" command is required but not installed. (Basic "
"Calulator)${RESET}"
msgstr ""

#: shrink_pdf:286
msgid "Shrink mode: Extreme"
msgstr ""

#: shrink_pdf:290
msgid ".TEMP_SHRINKED"
msgstr ""

#: shrink_pdf:291
msgid ".ORIGINAL"
msgstr ""

#: shrink_pdf:320
#, sh-format
msgid ""
"${WARN}SKIPPED${RESET} because it is probably the shrinking result of "
"\"${bak_file_filename}\""
msgstr ""

#: shrink_pdf:328
#, sh-format
msgid ""
"${WARN}SKIPPED${RESET} because it has been already shrinked before. To "
"shrink it again, rename it: remove \"${ORIGINAL_SUBEXT}\"."
msgstr ""

#: shrink_pdf:339
#, sh-format
msgid ""
"${ERR}ERROR: unable to delete \"${result_file}\" before starting shrinking. "
"Check access rights.${RESET}"
msgstr ""

#: shrink_pdf:354
#, sh-format
msgid ""
"${ERR}ERROR: The shrinking command failed and returned an error. Most likely "
"this is not a valid PDF file.${RESET}"
msgstr ""

#: shrink_pdf:358 shrink_pdf:390
#, sh-format
msgid ""
"${ERR}ERROR: something went wrong trying to delete the result file. Check "
"access rights.${RESET}"
msgstr ""

#: shrink_pdf:367
#, sh-format
msgid "${ERR}ERROR: something went wrong, no shrinking result file.${RESET}"
msgstr ""

#: shrink_pdf:383
#, sh-format
msgid ""
"${WARN}NOT shrinked:${RESET} most likely this file is already optimized."
msgstr ""

#: shrink_pdf:402
#, sh-format
msgid ""
"${ERR}ERROR: something went wrong after shrinking. Unable to rename the "
"original file as \"${bak_file}\". Check access rights.${RESET}"
msgstr ""

#: shrink_pdf:409
#, sh-format
msgid ""
"${ERR}ERROR: something went wrong after shrinking. Unable to rename the "
"temporary result file name \"${result_file}\" as the original file name. "
"Check access rights.${RESET}"
msgstr ""

#: shrink_pdf:414
#, sh-format
msgid ""
"${OK}${shrink_percent} % shrinked.${RESET}  (Original: "
"\"${bak_file_filename}\")"
msgstr ""

#: shrink_pdf:422
#, sh-format
msgid "${OK}${nb_file_ok} file successfully shrinked.${RESET}"
msgid_plural "${OK}${nb_file_ok} files successfully shrinked.${RESET}"
msgstr[0] ""
msgstr[1] ""

#: shrink_pdf:427
#, sh-format
msgid ""
"${OK}${nb_file_not_shrinked} file NOT shrinked: already small or previously "
"processed.${RESET}"
msgid_plural ""
"${OK}${nb_file_not_shrinked} files NOT shrinked: already small or previously "
"processed.${RESET}"
msgstr[0] ""
msgstr[1] ""

#: shrink_pdf:433
#, sh-format
msgid ""
"${ERR}${nb_file_error} file with error trying to shrink or rename it.${RESET}"
msgid_plural ""
"${ERR}${nb_file_error} files with errors trying to shrink or rename them."
"${RESET}"
